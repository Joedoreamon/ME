
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Snake Game</title>
<style>
  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #f5f5f5;
    font-family: Arial, sans-serif;
  }

  .game {
    text-align: center;
    background: white;
    padding: 25px;
    border-radius: 16px;
    box-shadow: 0 4px 20px #0001;
  }

  h1 {
    color: #4285f4;
    margin-top: 0;
  }

  .score {
    font-size: 20px;
    margin-bottom: 15px;
  }

  canvas {
    display: block;
    background: #e8f5e9;
    border: 3px solid #ddd;
    border-radius: 5px;
    max-width: 100%;
  }

  button {
    margin-top: 18px;
    padding: 12px 25px;
    border: none;
    border-radius: 8px;
    background: #4285f4;
    color: white;
    font-size: 16px;
    cursor: pointer;
  }

  button:hover { background: #2872df; }

  p { color: #666; font-size: 13px; }
</style>
</head>
<body>

<div class="game">
  <h1>Snake</h1>
  <div class="score">Score: <span id="score">0</span></div>
  <canvas id="canvas" width="400" height="400"></canvas>
  <button onclick="restart()">Restart Game</button>
  <p>Use arrow keys or WASD to move.</p>
  <p>Eat the food. Avoid walls and yourself!</p>
  <h3 id="message">Press an arrow key to start</h3>
</div>

<script>
const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");
const scoreDisplay = document.getElementById("score");
const message = document.getElementById("message");

const size = 20;
const tiles = canvas.width / size;

let snake, food, dx, dy, score, running, gameOver;
let timer;

function restart() {
  snake = [
    {x: 10, y: 10},
    {x: 9, y: 10},
    {x: 8, y: 10}
  ];

  dx = 0;
  dy = 0;
  score = 0;
  running = false;
  gameOver = false;

  scoreDisplay.textContent = score;
  message.textContent = "Press an arrow key to start";

  createFood();
  clearInterval(timer);
  draw();
}

function createFood() {
  do {
    food = {
      x: Math.floor(Math.random() * tiles),
      y: Math.floor(Math.random() * tiles)
    };
  } while (snake.some(part =>
    part.x === food.x && part.y === food.y
  ));
}

function draw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // Food
  ctx.fillStyle = "#ea4335";
  ctx.beginPath();
  ctx.arc(
    food.x * size + size / 2,
    food.y * size + size / 2,
    size / 2 - 2, 0, Math.PI * 2
  );
  ctx.fill();

  // Snake
  snake.forEach((part, index) => {
    ctx.fillStyle = index === 0 ? "#188038" : "#34a853";
    ctx.fillRect(
      part.x * size + 1,
      part.y * size + 1,
      size - 2,
      size - 2
    );
  });
}

function update() {
  if (gameOver || !running) return;

  const head = {
    x: snake[0].x + dx,
    y: snake[0].y + dy
  };

  const eating = head.x === food.x && head.y === food.y;

  // Wall collision
  if (
    head.x < 0 || head.x >= tiles ||
    head.y < 0 || head.y >= tiles
  ) {
    endGame();
    return;
  }

  // Self collision
  const body = eating ? snake : snake.slice(0, -1);

  if (body.some(part =>
    part.x === head.x && part.y === head.y
  )) {
    endGame();
    return;
  }

  snake.unshift(head);

  if (eating) {
    score += 10;
    scoreDisplay.textContent = score;
    createFood();

    // Increase speed
    clearInterval(timer);
    timer = setInterval(update, Math.max(55, 130 - score / 10));
  } else {
    snake.pop();
  }

  draw();
}

function endGame() {
  gameOver = true;
  running = false;
  clearInterval(timer);
  message.textContent = "Game Over! Score: " + score;
}

function start() {
  if (gameOver || running) return;

  running = true;
  message.textContent = "Game in progress";
  timer = setInterval(update, 130);
}

document.addEventListener("keydown", (e) => {
  const keys = {
    ArrowUp: [0, -1],
    ArrowDown: [0, 1],
    ArrowLeft: [-1, 0],
    ArrowRight: [1, 0],
    w: [0, -1],
    s: [0, 1],
    a: [-1, 0],
    d: [1, 0]
  };

  const direction = keys[e.key];
  if (!direction) return;

  e.preventDefault();

  const [newDx, newDy] = direction;

  // Prevent reversing direction
  if (newDx === -dx && newDy === -dy) return;

  if (dx === 0 && dy === 0 ||
      !(newDx === -dx && newDy === -dy)) {
    dx = newDx;
    dy = newDy;
    start();
  }
});

restart();
</script>
</body>
</html>

